<script is:inline>
  document.getElementById("menu-btn").addEventListener("click", () => document.getElementById("mobile-menu").classList.toggle("hidden"));
  // reveal on scroll
  const io = new IntersectionObserver(es => es.forEach(e => e.isIntersecting && (e.target.classList.add("in"), io.unobserve(e.target))), { threshold: 0.12 });
  document.querySelectorAll("[data-reveal]").forEach(el => io.observe(el));
  // carousel
  const track = document.getElementById("reel-track"), dots = document.getElementById("reel-dots");
  const cards = track.children, n = cards.length;
  for (let i = 0; i < n; i++) { const d = document.createElement("button"); d.className = "w-2.5 h-2.5 rounded-full bg-[#d8cdb4] transition"; d.setAttribute("aria-label","Go to story "+(i+1)); d.onclick = () => cards[i].scrollIntoView({behavior:"smooth", inline:"center", block:"nearest"}); dots.appendChild(d); }
  function setDot(){ const i = Math.round(track.scrollLeft / (cards[0].offsetWidth + 16)); [...dots.children].forEach((d,j)=>d.classList.toggle("bg-[var(--gold)]", j===Math.min(i,n-1))); }
  track.addEventListener("scroll", () => requestAnimationFrame(setDot)); setDot();
  document.getElementById("reel-prev").onclick = () => track.scrollBy({left: -cards[0].offsetWidth - 16, behavior:"smooth"});
  document.getElementById("reel-next").onclick = () => track.scrollBy({left: cards[0].offsetWidth + 16, behavior:"smooth"});
  // cart
  let count = 0; const badge = document.getElementById("cart-count");
  document.querySelectorAll(".add-cart").forEach(b => b.addEventListener("click", () => { count++; badge.textContent = count; badge.classList.remove("hidden"); badge.classList.add("flex"); }));
  document.querySelectorAll("[data-buy]").forEach(b => b.addEventListener("click", () => { alert("Taking you to secure checkout for " + b.dataset.buy + " — COD and online payment both available."); }));
  // faq single-open
  document.querySelectorAll("#faq details").forEach(d => d.addEventListener("toggle", () => { if (d.open) document.querySelectorAll("#faq details").forEach(o => o !== d && (o.open = false)); }));
</script>
