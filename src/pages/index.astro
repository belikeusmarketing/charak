---
import Base from "../layouts/Base.astro";
import KleapForm from "@/components/KleapForm";
const testimonialVideos = [
  { name: "Amit S.", city: "Indore", caption: "Hair fall kam hua aur improvement notice hua.", dur: "1:24", thumb: "https://images.pexels.com/photos/28994388/pexels-photo-28994388.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" },
  { name: "Sneha P.", city: "Ujjain", caption: "Scalp ki problem ab kaafi kam ho gayi.", dur: "0:58", thumb: "https://images.pexels.com/photos/6594747/pexels-photo-6594747.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" },
  { name: "Rohit K.", city: "Dewas", caption: "6 weeks me visible improvement notice kiya.", dur: "1:12", thumb: "https://images.pexels.com/photos/29201032/pexels-photo-29201032.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" },
  { name: "Neha T.", city: "Pithampur", caption: "Products natural hain aur hair better feel hote hain.", dur: "1:05", thumb: "https://images.pexels.com/photos/37114348/pexels-photo-37114348.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" },
  { name: "Imran S.", city: "Indore", caption: "Dandruff ki problem me improvement mila.", dur: "0:49", thumb: "https://images.pexels.com/photos/5720765/pexels-photo-5720765.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" },
  { name: "Pooja M.", city: "Ujjain", caption: "Mere baal pehle se stronger feel hote hain.", dur: "1:31", thumb: "https://images.pexels.com/photos/28994390/pexels-photo-28994390.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" },
];
const products = [
  { name: "Hair Care Oil", qty: "Net Qty: 50ml", desc: "Nourishes the scalp, supports stronger-looking roots and healthy hair.", price: "₹499", img: "https://images.pexels.com/photos/17307533/pexels-photo-17307533.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" },
  { name: "Hair Shampoo", qty: "Net Vol: 100ml", desc: "Gently cleanses the hair and scalp while supporting healthy-looking hair.", price: "₹349", img: "https://images.pexels.com/photos/7148534/pexels-photo-7148534.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" },
  { name: "Hair Churan", qty: "Net Wt: 50gm", desc: "Supports internal nourishment and digestive wellness.", price: "₹299", img: "https://images.pexels.com/photos/34928280/pexels-photo-34928280.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" },
  { name: "Hair Capsules", qty: "30 Capsules", desc: "Provides nutritional support for stronger, healthier-looking hair.", price: "₹399", img: "https://images.pexels.com/photos/11465970/pexels-photo-11465970.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" },
  { name: "Detoxifier Churan", qty: "Net Wt: 90gm", desc: "Supports digestion and overall wellness.", price: "₹349", img: "https://images.pexels.com/photos/34928286/pexels-photo-34928286.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" },
];
const camps = [
  { city: "Indore — Khajrana", day: "Every Sunday", time: "11 AM – 7 PM", addr: "Near Bade Madarse, Opposite Royal Care Hospital, Indore" },
  { city: "Pithampur", day: "Every Sunday", time: "12 PM – 5 PM", addr: "Hotel Handi, Chaupati, Near Manaal Hotel, Pithampur" },
  { city: "Ujjain", day: "Every Monday", time: "11 AM – 5 PM", addr: "In front of Madhya Pradesh Gramin Bank, Nanakheda, Ujjain" },
  { city: "Dewas", day: "Every Monday", time: "11 AM – 5 PM", addr: "Near Bus Stand, Mandi Dharamshala, Dewas" },
];
const faqs = [
  { q: "Is the checkup really free?", a: "Yes. Every hair camp visit includes a completely free hair and scalp checkup — no purchase necessary." },
  { q: "How does the hair camp consultation work?", a: "You visit a camp near you, our team assesses your hair and scalp, understands your concerns and gives you personalized Ayurvedic guidance." },
  { q: "How long does it take to see results?", a: "Every person is different. Many customers report noticing improvement within a few weeks of consistent use, but outcomes vary." },
  { q: "Can men and women use these products?", a: "Yes, the complete Charak Hair Care range is suitable for both men and women of all hair types." },
  { q: "How should I use the products?", a: "Each product comes with clear usage instructions on its pack. You'll also receive a personalized routine at your camp checkup or on WhatsApp." },
  { q: "Do you offer Cash on Delivery?", a: "Yes, COD is available across India along with prepaid online payment options." },
  { q: "Can I order the products online?", a: "Yes. Add products to your cart and checkout here, or message us on WhatsApp at 7038829809 for assistance." },
  { q: "Where are the Charak Hair Care camps located?", a: "We run weekly camps in Indore (Khajrana), Pithampur, Ujjain and Dewas — see the Hair Camps section for days and timings." },
  { q: "Can I contact Charak Hair Care on WhatsApp?", a: "Absolutely — message us anytime at 7038829809 and our team will help you." },
];
const wa = "https://wa.me/917038829809";
const isEditorial = false;
const wcStoreUrl = "https://yellowgreen-gnu-156694.hostingersite.com/wp-json/wc/store/v1";
---
<Base title="JEEV ANKUR — Ayurvedic Hair Care by Charak Hair Care" description="Complete Ayurvedic care for hair fall, weak roots, dandruff and scalp health. Free hair checkups, weekly camps in MP, Pan India delivery & COD available.">
<style is:global>
  :root { --forest:#123524; --botanical:#1e4632; --sage:#7a9b76; --gold:#b99457; --cream:#f7f2e7; --ivory:#fdfaf3; --beige:#e9dfc9; }
  body { font-family: 'Manrope', sans-serif; background: var(--ivory); color: #22301f; }
  .serif { font-family: 'Fraunces', serif; }
  .btn-primary { background:#123524; color:#fdfaf3; }
  .btn-primary:hover { background:#1e4632; }
  .btn-gold { background: var(--gold); color:#1c1408; }
  .chip { border:1px solid var(--beige); background: var(--cream); }
  [data-reveal]{opacity:0; transform:translateY(28px); transition:opacity .7s ease, transform .7s ease;}
  [data-reveal].in{opacity:1; transform:none;}
  .reel { aspect-ratio: 9/16; }
  .no-scrollbar::-webkit-scrollbar{display:none} .no-scrollbar{scrollbar-width:none}
  details[open] .faq-icon{transform:rotate(45deg)}
</style>

<!-- Announcement bar -->
<div class="bg-[var(--forest)] text-[var(--cream)] text-xs md:text-sm">
  <div class="max-w-7xl mx-auto px-4 py-2 flex flex-wrap items-center justify-center md:justify-between gap-2">
    <p>100% Ayurvedic &nbsp;|&nbsp; No Harsh Chemicals &nbsp;|&nbsp; Trusted by Thousands</p>
    <a href={wa} class="underline underline-offset-2 text-[#fdfaf3] hover:text-white">Call / WhatsApp: 7038829809</a>
  </div>
</div>

<!-- Sticky header -->
<header class="sticky top-0 z-50 bg-[var(--ivory)]/95 backdrop-blur border-b border-[var(--beige)]">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
    <a href="/" class="leading-tight">
      <div class="serif text-xl md:text-2xl font-bold tracking-wide text-[var(--forest)]">JEEV ANKUR</div>
      <div class="text-[10px] md:text-xs tracking-[0.25em] text-[var(--gold)] uppercase">By Charak Hair Care</div>
    </a>
    <nav class="hidden lg:flex items-center gap-6 text-sm font-medium">
      <a href="/" class="hover:text-[var(--forest)]">Home</a>
      <a href="#about" class="hover:text-[var(--forest)]">About</a>
      <a href="#products" class="hover:text-[var(--forest)]">Products</a>
      <a href="#camps" class="hover:text-[var(--forest)]">Hair Camps</a>
      <a href="#stories" class="hover:text-[var(--forest)]">Real Stories</a>
      <a href="#how" class="hover:text-[var(--forest)]">How to Use</a>
      <a href="#faq" class="hover:text-[var(--forest)]">FAQ</a>
      <a href="#contact" class="hover:text-[var(--forest)]">Contact</a>
    </nav>
    <div class="flex items-center gap-3">
      <button aria-label="Search" class="hidden md:block p-2 rounded-full hover:bg-[var(--cream)]">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m21 21-4-4"/></svg>
      </button>
      <button aria-label="Cart" class="relative p-2 rounded-full hover:bg-[var(--cream)]">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18M16 10a4 4 0 0 1-8 0"/></svg>
        <span id="cart-count" class="hidden absolute -top-1 -right-1 bg-[var(--gold)] text-[10px] font-bold w-5 h-5 rounded-full items-center justify-center text-[#1c1408]">0</span>
      </button>
      <a href="#products" class="hidden sm:inline-flex btn-primary text-sm font-semibold px-5 py-2.5 rounded-full">Order Now</a>
      <button id="menu-btn" aria-label="Menu" class="lg:hidden p-2 rounded-full hover:bg-[var(--cream)]">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="hidden lg:hidden border-t border-[var(--beige)] bg-[var(--ivory)] px-4 py-4">
    <nav class="flex flex-col gap-3 text-sm font-medium">
      <a href="/">Home</a><a href="#about">About</a><a href="#products">Products</a><a href="#camps">Hair Camps</a><a href="#stories">Real Stories</a><a href="#how">How to Use</a><a href="#faq">FAQ</a><a href="#contact">Contact</a>
      <a href="#products" class="btn-primary text-center font-semibold px-5 py-3 rounded-full mt-2">Order Now</a>
    </nav>
  </div>
</header>

<main>
<!-- HERO -->
<section class="relative overflow-hidden bg-[var(--cream)]">
  <svg class="absolute -top-6 -left-8 w-40 opacity-10 text-[var(--forest)]" viewBox="0 0 100 100" fill="currentColor"><path d="M50 5C20 25 10 55 25 90c30-10 45-40 25-85Z"/><path d="M55 15 30 80" stroke="currentColor" stroke-width="2" fill="none"/></svg>
  <svg class="absolute bottom-0 right-0 w-56 opacity-10 text-[var(--forest)]" viewBox="0 0 100 100" fill="currentColor"><path d="M95 10C55 20 30 55 40 95c35-5 55-40 55-85Z"/></svg>
  <div class="max-w-7xl mx-auto px-4 py-16 md:py-24 grid lg:grid-cols-[1.1fr_1fr] gap-12 items-center">
    <div data-reveal>
      <p class="text-xs md:text-sm tracking-[0.3em] uppercase text-[#7a5a1e] font-semibold">Ayurvedic Hair Care for a Healthier You</p>
      <h1 class="serif text-5xl md:text-7xl font-bold mt-4 leading-[1.05] text-[var(--forest)]">Stronger Roots<br/>Healthier Hair<br/>Naturally</h1>
      <p class="mt-6 text-lg text-[#4c5b45] max-w-xl">Complete Ayurvedic care for hair fall, weak roots, dandruff and scalp health.</p>
      <div class="mt-7 grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs sm:text-sm font-medium min-w-0">
        {["100% Ayurvedic","No Harsh Chemicals","Suitable for All Hair Types","Trusted by Thousands"].map(t => <div class="chip rounded-full px-2.5 py-2 text-center text-[#3c4a36] leading-tight break-words">{t}</div>)}
      </div>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#products" class="btn-primary font-semibold px-7 py-3.5 rounded-full shadow-lg shadow-[var(--forest)]/20">Order Now →</a>
        <a href={wa} class="border border-[var(--forest)] text-[var(--forest)] font-semibold px-7 py-3.5 rounded-full hover:bg-[var(--forest)] hover:text-white">Chat on WhatsApp</a>
      </div>
    </div>
    <div class="relative" data-reveal>
      <div class="rounded-3xl overflow-hidden shadow-2xl bg-[var(--beige)]">
        <img src="https://assets.kleap.io/103503/images/1790181563300-ChatGPT_Image_Sep_23__2026__03_38_29_PM.png" alt="JEEV ANKUR Ayurvedic hair care product range with natural ingredients" class="w-full h-[420px] md:h-[540px] object-cover" />
      </div>
      <div class="absolute top-3 left-3 md:-top-6 md:-left-6 w-24 h-24 md:w-32 md:h-32 rounded-full bg-[var(--gold)] text-[#1c1408] flex flex-col items-center justify-center text-center shadow-xl rotate-[-8deg] border-4 border-[var(--ivory)]">
        <span class="text-[10px] font-bold tracking-widest">COMPLETE</span>
        <span class="serif text-2xl md:text-3xl font-bold leading-none">5 IN 1</span>
        <span class="text-[10px] font-bold tracking-widest">HAIR CARE</span>
      </div>
      <div class="absolute -bottom-5 right-4 chip rounded-full px-4 py-2 text-xs font-semibold text-[var(--forest)] shadow">Hair Oil • Shampoo • Churan • Capsules • Detoxifier</div>
    </div>
  </div>
  <!-- benefit strip -->
  <div class="bg-[var(--forest)] text-[var(--cream)]">
    <div class="max-w-7xl mx-auto px-4 py-4 grid grid-cols-2 md:grid-cols-4 gap-3 text-sm font-medium text-center">
      {["Visit Our Hair Camps","100% Original Charak Hair Care","Pan India Delivery","COD Available"].map(t => <div>{t}</div>)}
    </div>
  </div>
</section>

<!-- TESTIMONIAL VIDEOS 9:16 -->
<section id="stories" class="py-20 md:py-28 bg-[var(--ivory)]">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center max-w-2xl mx-auto" data-reveal>
      <p class="text-xs tracking-[0.3em] uppercase text-[#7a5a1e] font-semibold">Real People • Real Stories</p>
      <h2 class="serif text-4xl md:text-5xl font-bold mt-3 text-[var(--forest)]">Hear It From Our Customers</h2>
      <p class="mt-4 text-[#4c5b45]">Real customer experiences and personal hair-care journeys with Charak Hair Care.</p>
    </div>
    <div class="relative mt-10" data-reveal>
      <div id="reel-track" class="flex gap-4 overflow-x-auto no-scrollbar snap-x snap-mandatory scroll-smooth pb-2">
        {testimonialVideos.map(v => (
          <div class="reel snap-center shrink-0 w-[78vw] sm:w-[320px] md:w-[calc((100%-4rem)/5)] rounded-2xl overflow-hidden border border-[var(--beige)] shadow-lg group relative bg-[var(--forest)]">
            <img src={v.thumb} alt={`Customer story — ${v.name}, ${v.city}`} loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:scale-105 transition duration-500" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-black/30"></div>
            <div class="absolute top-3 right-3 bg-black/60 text-white text-xs px-2 py-1 rounded-full">{v.dur}</div>
            <button aria-label="Play video" class="absolute inset-0 m-auto w-16 h-16 rounded-full bg-[var(--gold)]/95 flex items-center justify-center shadow-xl group-hover:scale-110 transition">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="#1c1408"><path d="M8 5v14l11-7z"/></svg>
            </button>
            <div class="absolute bottom-0 inset-x-0 p-4 text-white">
              <p class="text-sm leading-snug text-white">“{v.caption}”</p>
              <p class="mt-2 text-xs font-semibold tracking-wide text-[var(--gold)]">{v.name} · {v.city}</p>
            </div>
          </div>
        ))}
      </div>
      <button id="reel-prev" aria-label="Previous" class="hidden md:flex absolute -left-5 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white shadow-lg border border-[var(--beige)] items-center justify-center hover:bg-[var(--cream)]">‹</button>
      <button id="reel-next" aria-label="Next" class="hidden md:flex absolute -right-5 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white shadow-lg border border-[var(--beige)] items-center justify-center hover:bg-[var(--cream)]">›</button>
      <div id="reel-dots" class="flex justify-center gap-2 mt-6"></div>
    </div>
    <div class="text-center mt-8" data-reveal><a href={wa} class="text-[var(--forest)] font-semibold hover:underline">Watch More Customer Stories →</a></div>
  </div>
</section>

<!-- PRODUCTS -->
<section id="products" class="py-20 md:py-28 bg-[var(--cream)]">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center max-w-2xl mx-auto" data-reveal>
      <h2 class="serif text-4xl md:text-5xl font-bold text-[var(--forest)]">Our Ayurvedic Hair Care Products</h2>
      <p class="mt-4 text-[#4c5b45]">Shop the complete JEEV ANKUR Hair Care Kit directly from Charak Hair Care.</p>
    </div>
    <div id="product-grid" class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-4xl mx-auto">
      <article id="wc-product-card" class="bg-white rounded-2xl border border-[var(--beige)] shadow-sm hover:shadow-xl transition overflow-hidden flex flex-col" data-reveal>
        <div class="bg-[var(--beige)] relative">
          <img id="wc-product-image" src="https://images.pexels.com/photos/17307533/pexels-photo-17307533.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" alt="JEEV ANKUR Hair Care Kit" loading="lazy" class="w-full h-64 md:h-72 object-cover" />
          <span class="absolute top-4 left-4 bg-[var(--gold)] text-[#1c1408] text-xs font-bold px-3 py-1 rounded-full">ONLINE STORE</span>
        </div>
        <div class="p-6 flex flex-col gap-2 flex-1">
          <h3 id="wc-product-name" class="serif font-bold text-2xl text-[var(--forest)]">Jeev Ankur Hair Care Kit</h3>
          <p id="wc-product-desc" class="text-sm text-[#4c5b45] flex-1">Complete Ayurvedic hair-care routine with the products selected by Charak Hair Care.</p>
          <p id="wc-product-price" class="font-bold text-xl text-[var(--forest)]">Loading price…</p>
          <p id="wc-product-stock" class="text-xs font-semibold text-[var(--gold)]">Checking availability…</p>
          <div class="flex gap-2 mt-2">
            <button id="wc-add-cart" class="btn-primary text-sm font-semibold px-4 py-3 rounded-full flex-1">Add to Cart</button>
            <button id="wc-buy-now" class="text-sm font-semibold px-4 py-3 rounded-full flex-1 border border-[var(--forest)] text-[var(--forest)] hover:bg-[var(--forest)] hover:text-white">Buy Now</button>
          </div>
        </div>
      </article>
    </div>
    <p id="wc-store-error" class="hidden text-center mt-6 text-sm text-red-700 bg-red-50 border border-red-200 rounded-xl p-4 max-w-2xl mx-auto"></p>
  </div>
</section>

<!-- CART / CHECKOUT DRAWER -->
<div id="wc-cart-backdrop" class="hidden fixed inset-0 z-[80] bg-black/40"></div>
<aside id="wc-cart-drawer" class="fixed top-0 right-0 z-[90] h-full w-full max-w-md translate-x-full bg-[var(--ivory)] shadow-2xl transition-transform duration-300 flex flex-col" aria-hidden="true">
  <div class="p-5 border-b border-[var(--beige)] flex items-center justify-between">
    <div><h2 class="serif text-2xl font-bold text-[var(--forest)]">Your Cart</h2><p id="wc-cart-subtitle" class="text-xs text-[#4c5b45] mt-1">Secure checkout powered by WooCommerce</p></div>
    <button id="wc-cart-close" aria-label="Close cart" class="w-10 h-10 rounded-full border border-[var(--beige)] text-xl">×</button>
  </div>
  <div id="wc-cart-content" class="flex-1 overflow-y-auto p-5">
    <p class="text-sm text-[#4c5b45]">Loading cart…</p>
  </div>
  <div class="border-t border-[var(--beige)] p-5 bg-white">
    <div class="flex justify-between font-semibold text-[var(--forest)]"><span>Total</span><span id="wc-cart-total">₹0</span></div>
    <button id="wc-checkout-btn" class="btn-primary w-full mt-4 py-3 rounded-full font-semibold">Proceed to Checkout</button>
  </div>
</aside>

<div id="wc-checkout-modal" class="hidden fixed inset-0 z-[100] bg-black/50 p-4 overflow-y-auto">
  <div class="max-w-xl mx-auto my-8 bg-[var(--ivory)] rounded-3xl shadow-2xl overflow-hidden">
    <div class="p-5 border-b border-[var(--beige)] flex items-center justify-between">
      <div><h2 class="serif text-2xl font-bold text-[var(--forest)]">Secure Checkout</h2><p class="text-xs text-[#4c5b45] mt-1">Your order will be created in WooCommerce.</p></div>
      <button id="wc-checkout-close" class="w-10 h-10 rounded-full border border-[var(--beige)] text-xl">×</button>
    </div>
    <form id="wc-checkout-form" class="p-5 space-y-4">
      <div class="grid sm:grid-cols-2 gap-3">
        <input name="first_name" required placeholder="First name" class="w-full rounded-xl border border-[var(--beige)] bg-white px-4 py-3" />
        <input name="last_name" placeholder="Last name" class="w-full rounded-xl border border-[var(--beige)] bg-white px-4 py-3" />
      </div>
      <input name="email" type="email" required placeholder="Email address" class="w-full rounded-xl border border-[var(--beige)] bg-white px-4 py-3" />
      <input name="phone" required placeholder="Mobile number" class="w-full rounded-xl border border-[var(--beige)] bg-white px-4 py-3" />
      <input name="address_1" required placeholder="House / Street address" class="w-full rounded-xl border border-[var(--beige)] bg-white px-4 py-3" />
      <div class="grid sm:grid-cols-2 gap-3">
        <input name="city" required placeholder="City" class="w-full rounded-xl border border-[var(--beige)] bg-white px-4 py-3" />
        <input name="state" required placeholder="State (e.g. MP)" class="w-full rounded-xl border border-[var(--beige)] bg-white px-4 py-3" />
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        <input name="postcode" required inputmode="numeric" placeholder="PIN code" class="w-full rounded-xl border border-[var(--beige)] bg-white px-4 py-3" />
        <select name="country" class="w-full rounded-xl border border-[var(--beige)] bg-white px-4 py-3"><option value="IN">India</option></select>
      </div>
      <div>
        <label class="block text-sm font-semibold text-[var(--forest)] mb-2">Payment method</label>
        <div id="wc-payment-methods" class="space-y-2"><p class="text-sm text-[#4c5b45]">Loading payment methods…</p></div>
      </div>
      <p id="wc-checkout-message" class="hidden text-sm rounded-xl p-3"></p>
      <button id="wc-place-order" type="submit" class="btn-primary w-full py-3.5 rounded-full font-semibold">Place Order</button>
    </form>
  </div>
</div>

<!-- HAIR CONCERNS -->
<section class="py-20 md:py-28 bg-[var(--forest)] text-[var(--cream)]">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center max-w-2xl mx-auto" data-reveal>
      <h2 class="serif text-4xl md:text-5xl font-bold">Real Solutions for Real Hair Concerns</h2>
      <p class="mt-4 text-[var(--cream)]/80">Explore a holistic Ayurvedic approach to everyday hair and scalp concerns.</p>
    </div>
    <div class="mt-12 grid grid-cols-2 md:grid-cols-5 gap-4">
