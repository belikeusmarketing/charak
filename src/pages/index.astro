<script is:inline>
  const WC_STORE = "https://yellowgreen-gnu-156694.hostingersite.com/wp-json/wc/store/v1";
  const WC_SLUG = "jeev-ankur-hair-care-kit";
  let wcProduct = null;
  let wcCartToken = localStorage.getItem("charak_wc_cart_token") || "";

  const $ = (id) => document.getElementById(id);
  const money = (minor, currency = "INR") => new Intl.NumberFormat("en-IN", { style: "currency", currency, maximumFractionDigits: 0 }).format(Number(minor || 0) / 100);

  function showStoreError(message) {
    const el = $("wc-store-error");
    if (!el) return;
    el.textContent = message;
    el.classList.remove("hidden");
  }

  async function wcFetch(path, options = {}) {
    const headers = new Headers(options.headers || {});
    headers.set("Accept", "application/json");
    if (options.body && !headers.has("Content-Type")) headers.set("Content-Type", "application/json");
    if (wcCartToken) headers.set("Cart-Token", wcCartToken);
    const response = await fetch(WC_STORE + path, { ...options, headers, cache: "no-store" });
    const newToken = response.headers.get("Cart-Token");
    if (newToken) { wcCartToken = newToken; localStorage.setItem("charak_wc_cart_token", newToken); }
    const text = await response.text();
    let data = null;
    try { data = text ? JSON.parse(text) : null; } catch { data = { message: text }; }
    if (!response.ok) throw new Error(data?.message || data?.code || `WooCommerce request failed (${response.status})`);
    return data;
  }

  async function loadProduct() {
    try {
      const products = await wcFetch(`/products?slug=${encodeURIComponent(WC_SLUG)}`);
      wcProduct = products?.[0] || null;
      if (!wcProduct) throw new Error("Hair Care Kit product was not found in WooCommerce.");
      $("wc-product-name").textContent = wcProduct.name;
      $("wc-product-desc").innerHTML = wcProduct.short_description || wcProduct.description || "Complete JEEV ANKUR Hair Care Kit.";
      $("wc-product-price").textContent = money(wcProduct.prices?.price, wcProduct.prices?.currency_code || "INR");
      $("wc-product-stock").textContent = wcProduct.is_in_stock ? "In stock • Pan India delivery" : "Currently unavailable";
      if (wcProduct.images?.[0]?.src) $("wc-product-image").src = wcProduct.images[0].src;
      $("wc-add-cart").disabled = !wcProduct.is_in_stock;
      $("wc-buy-now").disabled = !wcProduct.is_in_stock;
    } catch (e) {
      showStoreError("WooCommerce connection needs one setup step. Please complete the CORS setup in WordPress, then reload this page.");
      $("wc-product-price").textContent = "Price unavailable";
      console.error(e);
    }
  }

  function openCart() {
    $("wc-cart-backdrop").classList.remove("hidden");
    $("wc-cart-drawer").classList.remove("translate-x-full");
    $("wc-cart-drawer").setAttribute("aria-hidden", "false");
    refreshCart();
  }
  function closeCart() {
    $("wc-cart-backdrop").classList.add("hidden");
    $("wc-cart-drawer").classList.add("translate-x-full");
    $("wc-cart-drawer").setAttribute("aria-hidden", "true");
  }

  async function refreshCart() {
    try {
      const cart = await wcFetch("/cart");
      const items = cart?.items || [];
      $("cart-count").textContent = items.reduce((n, item) => n + Number(item.quantity || 0), 0);
      $("cart-count").classList.toggle("hidden", !items.length);
      $("cart-count").classList.toggle("flex", !!items.length);
      $("wc-cart-total").textContent = money(cart?.totals?.total_price, cart?.totals?.currency_code || "INR");
      $("wc-cart-content").innerHTML = items.length ? items.map(item => `<div class="flex gap-3 py-3 border-b border-[var(--beige)]"><img src="${item.images?.[0]?.thumbnail || item.images?.[0]?.src || ""}" class="w-16 h-16 rounded-xl object-cover bg-[var(--beige)]" alt=""><div class="flex-1"><p class="font-semibold text-[var(--forest)]">${item.name}</p><p class="text-xs text-[#4c5b45] mt-1">Qty: ${item.quantity}</p><p class="text-sm font-semibold mt-1">${money(item.totals?.line_total, cart?.totals?.currency_code || "INR")}</p></div></div>`).join("") : `<div class="text-center py-10"><p class="font-semibold text-[var(--forest)]">Your cart is empty.</p><p class="text-sm text-[#4c5b45] mt-2">Add the Hair Care Kit to continue.</p></div>`;
      $("wc-checkout-btn").disabled = !items.length;
    } catch (e) {
      $("wc-cart-content").innerHTML = `<p class="text-sm text-red-700">Unable to load cart. Please refresh and try again.</p>`;
      console.error(e);
    }
  }

  async function addToCart(buyNow = false) {
    if (!wcProduct) return showStoreError("Product is still loading. Please try again in a moment.");
    try {
      await wcFetch(`/cart/add-item`, { method: "POST", body: JSON.stringify({ id: wcProduct.id, quantity: 1 }) });
      if (buyNow) { openCheckout(); } else { openCart(); }
    } catch (e) {
      showStoreError("Could not add the product to cart. Please reload and try again.");
      console.error(e);
    }
  }

  async function openCheckout() {
    try {
      closeCart();
      $("wc-checkout-modal").classList.remove("hidden");
      const checkout = await wcFetch("/checkout");
      const methods = checkout?.payment_methods || [];
      const container = $("wc-payment-methods");
      container.innerHTML = methods.length ? methods.map((m, i) => `<label class="flex items-center gap-3 border border-[var(--beige)] rounded-xl p-3 bg-white cursor-pointer"><input type="radio" name="payment_method" value="${m.id}" ${i === 0 ? "checked" : ""} /><span><span class="block font-semibold text-[var(--forest)]">${m.title || m.id}</span>${m.description ? `<span class="block text-xs text-[#4c5b45] mt-1">${m.description}</span>` : ""}</span></label>`).join("") : `<p class="text-sm text-red-700 bg-red-50 p-3 rounded-xl">No payment method is enabled in WooCommerce yet.</p>`;
    } catch (e) {
      $("wc-checkout-message").textContent = "Checkout could not be loaded. Please make sure a WooCommerce payment method is enabled.";
      $("wc-checkout-message").className = "text-sm rounded-xl p-3 bg-red-50 text-red-700";
      console.error(e);
    }
  }

  $("wc-add-cart").addEventListener("click", () => addToCart(false));
  $("wc-buy-now").addEventListener("click", () => addToCart(true));
  $("wc-cart-backdrop").addEventListener("click", closeCart);
  $("wc-cart-close").addEventListener("click", closeCart);
  $("wc-checkout-btn").addEventListener("click", openCheckout);
  $("wc-checkout-close").addEventListener("click", () => $("wc-checkout-modal").classList.add("hidden"));
  document.querySelector('button[aria-label="Cart"]')?.addEventListener("click", openCart);

  $("wc-checkout-form").addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = $("wc-place-order");
    const message = $("wc-checkout-message");
    button.disabled = true;
    button.textContent = "Placing Order…";
    message.className = "hidden text-sm rounded-xl p-3";
    const form = new FormData(event.currentTarget);
    const billing = {
      first_name: String(form.get("first_name") || ""), last_name: String(form.get("last_name") || ""), email: String(form.get("email") || ""), phone: String(form.get("phone") || ""), address_1: String(form.get("address_1") || ""), city: String(form.get("city") || ""), state: String(form.get("state") || ""), postcode: String(form.get("postcode") || ""), country: String(form.get("country") || "IN")
    };
    const payment_method = String(form.get("payment_method") || "");
    try {
      const result = await wcFetch("/checkout", { method: "POST", body: JSON.stringify({ billing_address: billing, shipping_address: billing, payment_method }) });
      if (result?.payment_result?.redirect_url) {
        window.location.href = result.payment_result.redirect_url;
      } else {
        message.textContent = `Order placed successfully. Order #${result.order_id || ""}`;
        message.className = "text-sm rounded-xl p-3 bg-green-50 text-green-800";
        button.textContent = "Order Placed ✓";
      }
    } catch (e) {
      message.textContent = e.message || "Unable to place order. Please check your details and try again.";
      message.className = "text-sm rounded-xl p-3 bg-red-50 text-red-700";
      button.disabled = false;
      button.textContent = "Place Order";
      console.error(e);
    }
  });

  document.getElementById("menu-btn").addEventListener("click", () => document.getElementById("mobile-menu").classList.toggle("hidden"));
  const io = new IntersectionObserver(es => es.forEach(e => e.isIntersecting && (e.target.classList.add("in"), io.unobserve(e.target))), { threshold: 0.12 });
  document.querySelectorAll("[data-reveal]").forEach(el => io.observe(el));
  const track = document.getElementById("reel-track"), dots = document.getElementById("reel-dots");
  const cards = track.children, n = cards.length;
  for (let i = 0; i < n; i++) { const d = document.createElement("button"); d.className = "w-2.5 h-2.5 rounded-full bg-[#d8cdb4] transition"; d.setAttribute("aria-label","Go to story "+(i+1)); d.onclick = () => cards[i].scrollIntoView({behavior:"smooth", inline:"center", block:"nearest"}); dots.appendChild(d); }
  function setDot(){ const i = Math.round(track.scrollLeft / (cards[0].offsetWidth + 16)); [...dots.children].forEach((d,j)=>d.classList.toggle("bg-[var(--gold)]", j===Math.min(i,n-1))); }
  track.addEventListener("scroll", () => requestAnimationFrame(setDot)); setDot();
  document.getElementById("reel-prev").onclick = () => track.scrollBy({left: -cards[0].offsetWidth - 16, behavior:"smooth"});
  document.getElementById("reel-next").onclick = () => track.scrollBy({left: cards[0].offsetWidth + 16, behavior:"smooth"});
  document.querySelectorAll("#faq details").forEach(d => d.addEventListener("toggle", () => { if (d.open) document.querySelectorAll("#faq details").forEach(o => o !== d && (o.open = false)); }));

  loadProduct();
</script>
</Base>
